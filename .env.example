# Database
DATABASE_URL="file:./dev.db"

# Authentication Secret (used for signing JWT session cookies)
AUTH_SECRET="pushhub-super-secret-production-grade-key-32-chars-minimum"

# Web Push VAPID Keys
# Can be generated via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@pushhub.dev"
