# ==============================================================================
# PushHub Environment Configuration Template
# Copy this file to '.env.local' for local development:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (Turso Cloud SQLite / LibSQL)
# ------------------------------------------------------------------------------
# Primary database URL used by Prisma CLI & schema (starts with libsql://)
DATABASE_URL="libsql://<your-database-name>.turso.io"

# Turso connection URL (same as DATABASE_URL or libsql connection string)
TURSO_DATABASE_URL="libsql://<your-database-name>.turso.io"

# Turso authentication token generated via `turso db tokens create <db-name>`
TURSO_AUTH_TOKEN="<your-turso-auth-token>"

# ------------------------------------------------------------------------------
# 2. Administrator & Session Authentication
# ------------------------------------------------------------------------------
# Administrator portal password for admin@pushhub.dev.
# Updating this env var automatically synchronizes the admin password hash on next login.
ADMIN_PASSWORD="adminPassword123!"

# Secret key used for signing JWT session cookies (must be at least 32 characters long)
AUTH_SECRET="pushhub-super-secret-production-grade-key-32-chars-minimum"

# ------------------------------------------------------------------------------
# 3. Web Push Protocol (VAPID Keys)
# Generate a new pair using: npx web-push generate-vapid-keys
# ------------------------------------------------------------------------------
# Public VAPID key used for server-side push payload encryption
VAPID_PUBLIC_KEY="<your-vapid-public-key>"

# Private VAPID key used to sign web push JWT tokens (never exposed to browser)
VAPID_PRIVATE_KEY="<your-vapid-private-key>"

# Contact URI included in the VAPID token (e.g., mailto:admin@yourdomain.com)
VAPID_SUBJECT="mailto:admin@pushhub.dev"

# Public VAPID key exposed to browser for PushManager.subscribe()
NEXT_PUBLIC_VAPID_PUBLIC_KEY="<your-vapid-public-key>"
